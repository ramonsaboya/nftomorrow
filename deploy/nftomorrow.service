[Unit]
Description=Tomorrowland NFT price monitor
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=nftomorrow
Group=nftomorrow
WorkingDirectory=/opt/nftomorrow
EnvironmentFile=/etc/nftomorrow/environment
ExecStart=/usr/local/bin/node /opt/nftomorrow/src/service.js
Restart=on-failure
RestartSec=15
TimeoutStopSec=120
StateDirectory=nftomorrow
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/nftomorrow
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftomorrow

[Install]
WantedBy=multi-user.target
