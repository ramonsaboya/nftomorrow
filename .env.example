# Local copies are ignored by Git. Production: /etc/nftomorrow/environment, mode 0600.
CONFIG_PATH=./config.json
DATA_DIR=./data
# Image generation and editing use this separate server-side API key; never paste it into chat.
OPENAI_API_KEY=
OPENAI_IMAGE_QUALITY=max
# Maximum paid image attempts across all chats per UTC day; failures count too.
STICKER_DAILY_LIMIT=20
# Optional CoinGecko Demo key, needed only for USD/GBP/EUR (see README).
COINGECKO_DEMO_API_KEY=
# Three independent Healthchecks.io checks; attach your verified email in its UI.
HEALTHCHECK_PRICES_URL=
HEALTHCHECK_WHATSAPP_URL=
HEALTHCHECK_PROCESS_URL=
